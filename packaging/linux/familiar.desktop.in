[Desktop Entry]
Type=Application
Name=Familiar
GenericName=Voice Companion
Comment=Pick a game and a companion, then talk (push-to-talk)
Exec=@LAUNCHER@ gui
Icon=familiar
Terminal=false
Categories=Utility;
Keywords=voice;companion;assistant;ats;
Actions=ats;ets2;desk;

[Desktop Action ats]
Name=Terminal: ATS
Exec=@LAUNCHER@ voice --game ats

[Desktop Action ets2]
Name=Terminal: ETS2
Exec=@LAUNCHER@ voice --game ets2

[Desktop Action desk]
Name=Terminal: Desk chat
Exec=@LAUNCHER@ voice
